ListView {
    border: solid $accent;
}

ListItem {
    height: auto;
    padding: 0 1;
}

.worktree-item {
    height: auto;
}

.worktree-name {
    text-style: bold;
}

.worktree-branch {
    color: $accent;
}

.worktree-path {
    color: $text-muted;
}

.pull-request-item {
    height: auto;
}

.pull-request-title {
    text-style: bold;
}

.pull-request-branch {
    color: $accent;
}

.pull-request-status {
    color: $text-muted;
}

.pull-request-message {
    color: $text-muted;
}

WorktreeDetailsModal {
    align: center middle;
}

#worktree-details-dialog {
    width: 60;
    max-width: 80%;
    height: auto;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

.worktree-details-title {
    text-style: bold;
    margin-bottom: 1;
}

.worktree-details-field {
    margin-bottom: 1;
}
