ListView {
    border: solid $accent;
}

ListItem {
    height: auto;
    padding: 0 1;
}

.worktree-item {
    height: auto;
}

.worktree-name {
    text-style: bold;
}

.worktree-branch {
    color: $accent;
}

.worktree-path {
    color: $text-muted;
}

.pull-request-item {
    height: auto;
}

.pull-request-title {
    text-style: bold;
}

.pull-request-branch {
    color: $accent;
}

.pull-request-status {
    color: $text-muted;
}

.pull-request-message {
    color: $text-muted;
}
