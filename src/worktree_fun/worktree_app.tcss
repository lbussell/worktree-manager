ListView {
    border: solid $accent;
}

ListItem {
    height: auto;
    padding: 0 1;
}

.worktree-item {
    height: auto;
}

.worktree-name {
    text-style: bold;
}

.worktree-branch {
    color: $accent;
}

.worktree-path {
    color: $text-muted;
}

.pull-request-item {
    height: auto;
}

.pull-request-title {
    text-style: bold;
}

.pull-request-branch {
    color: $accent;
}

.pull-request-status {
    color: $text-muted;
}

.pull-request-message {
    color: $text-muted;
}

WorktreeDetailsModal {
    align: center middle;
}

#worktree-details-dialog {
    width: 60;
    max-width: 80%;
    height: auto;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

.worktree-details-title {
    text-style: bold;
    margin-bottom: 1;
}

.worktree-details-field {
    margin-bottom: 1;
}

CreateWorktreeModal {
    align: center middle;
}

#create-worktree-dialog {
    width: 72;
    max-width: 90%;
    height: auto;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

.create-worktree-title {
    text-style: bold;
    margin-bottom: 1;
}

.create-worktree-label {
    margin-top: 1;
}

.create-worktree-help {
    color: $text-muted;
    margin-top: 1;
}

.create-worktree-status {
    color: $text-muted;
    margin-top: 1;
}

#create-worktree-new-branch-fields {
    margin-top: 1;
}

#create-worktree-existing-branch-fields {
    margin-top: 1;
}

.create-worktree-buttons {
    height: auto;
    margin-top: 1;
}

DeleteWorktreeModal {
    align: center middle;
}

#delete-worktree-dialog {
    width: 72;
    max-width: 90%;
    height: auto;
    border: round $accent;
    background: $surface;
    padding: 1 2;
}

.delete-worktree-title {
    text-style: bold;
    margin-bottom: 1;
}

.delete-worktree-field {
    margin-bottom: 1;
}

.delete-worktree-help {
    color: $text-muted;
    margin-top: 1;
}

.delete-worktree-buttons {
    height: auto;
    margin-top: 1;
}

ForceDeleteBranchModal {
    align: center middle;
}

#force-delete-branch-dialog {
    width: 72;
    max-width: 90%;
    height: auto;
    border: round $error;
    background: $surface;
    padding: 1 2;
}

.force-delete-branch-title {
    text-style: bold;
    margin-bottom: 1;
}

.force-delete-branch-warning {
    color: $error;
    margin-bottom: 1;
}

.force-delete-branch-field {
    margin-bottom: 1;
}

.force-delete-branch-help {
    color: $text-muted;
    margin-top: 1;
}

.force-delete-branch-buttons {
    height: auto;
    margin-top: 1;
}
